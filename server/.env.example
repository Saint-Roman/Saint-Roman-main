PORT=4000

# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
# WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID: send messages
# WHATSAPP_VERIFY_TOKEN: any string you choose — must match what you enter in the webhook setup UI
# WHATSAPP_APP_SECRET: App Settings > Basic — verifies inbound webhook requests are really from Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Abandoned cart reminders (server/lib/abandonedCarts.js) — this is a business-initiated message,
# so it needs a Message Template created and approved in Meta Business Manager first (the WhatsApp
# credentials above alone aren't enough). Name it here exactly as approved; language defaults to
# English if unset.
WHATSAPP_ABANDONED_CART_TEMPLATE=
WHATSAPP_ABANDONED_CART_TEMPLATE_LANG=en
